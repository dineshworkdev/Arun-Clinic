# ==========================================
# Dental Clinic AI Receptionist - Backend Configuration
# ==========================================

# Port for the Express API server
PORT=5000

# AI Provider API Keys (Set at least one)
# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Active AI Provider: "gemini" | "openai" (defaults to gemini if GEMINI_API_KEY is present)
AI_PROVIDER=gemini

# Model name override (optional)
# For Gemini: gemini-1.5-flash or gemini-2.0-flash (default: gemini-1.5-flash)
# For OpenAI: gpt-4o-mini or gpt-4o (default: gpt-4o-mini)
AI_MODEL=gemini-1.5-flash
